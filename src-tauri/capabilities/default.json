{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "ChartExtractor 默认权限集（最小权限）",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "dialog:allow-open",
    "dialog:allow-save",
    "opener:allow-open-path",
    "opener:allow-default-urls",
    "opener:allow-reveal-item-in-dir"
  ]
}
