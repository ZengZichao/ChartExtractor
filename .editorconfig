# EditorConfig：编辑器与格式化工具共享的基础约定。
# 缩进/换行/尾随空白的权威来源是 .prettierrc + .editorconfig 两者配合：
# Prettier 管代码排版，EditorConfig 管它不管的部分（Markdown、YAML 的空白等）。
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{ts,tsx,js,jsx,json,jsonc,css,yml,yaml}]
indent_style = space
indent_size = 2

[*.md]
# Markdown 的行尾双空格是换行语义，不能被裁掉
trim_trailing_whitespace = false

[LICENSE]
# 许可证正文含排版用的行尾空格，属于正文的一部分
trim_trailing_whitespace = false
