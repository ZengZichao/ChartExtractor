{
  "name": "chart-data-extractor",
  "version": "0.1.0",
  "description": "离线图表数据提取工具（中英双语界面）- 纯本地运行（Tauri v2 + React + TypeScript）",
  "author": "Zichao Zeng",
  "license": "GPL-3.0",
  "scripts": {
    "dev": "vite",
    "build:renderer": "vite build",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "tauri": "tauri",
    "package": "tauri build",
    "lint:offline": "node scripts/lint-offline.js",
    "lint:i18n": "node scripts/lint-i18n.js",
    "test": "vitest run && node scripts/lint-offline.js && node scripts/lint-i18n.js",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "jszip": "^3.10.1",
    "lucide-react": "^1.43.0",
    "pdfjs-dist": "^4.7.76",
    "radix-ui": "^1.6.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/node": "^26.6.2",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "prettier": "^3.9.6",
    "typescript": "^5.5.4",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
